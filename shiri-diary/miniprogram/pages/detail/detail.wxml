<view class="page"><view wx:if="error" class="error">{{error}}</view><block wx:if="entry"><view class="eyebrow">A PAGE OF MY LIFE</view><view class="detail-date">{{dateLabel}}</view><view class="heading detail-title">{{entry.title}}</view><view class="row gap"><text class="pill">{{entry.moodSymbol}} {{entry.moodLabel}}</text><text class="tiny-label">{{entry.weather}} · {{entry.wordCount}} 字</text></view><view class="detail-paper"><text class="body-copy" selectable>{{entry.content}}</text></view><view><text wx:for="{{entry.tags}}" wx:key="*this" class="tag">#{{item}}</text></view><view class="line"></view><button class="secondary full" bindtap="edit">继续编辑这一天</button><button class="quiet danger full delete" bindtap="remove">删除这篇日记</button></block></view>
