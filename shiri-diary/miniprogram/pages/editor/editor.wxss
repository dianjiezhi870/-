.title-input{font-family:"Songti SC",serif;font-size:43rpx;height:120rpx;margin:12rpx 0 25rpx;font-weight:600}.restore{margin:24rpx 0 8rpx}.choices{display:flex;flex-wrap:wrap;gap:13rpx}.choice{padding:15rpx 22rpx;background:#eeeEE5;color:#939989;font-size:25rpx;border:1rpx solid transparent;border-radius:15rpx}.choice.chosen{background:#e6eadf;border-color:#c1ccb5;color:#56704f}.weather-row{display:flex;align-items:center;gap:16rpx;margin:25rpx 0 30rpx}.weather{background:transparent;color:#9a9d8e;font-size:24rpx;padding:8rpx 10rpx}.weather.chosen{color:#607a55;background:#e8ebdf;border-radius:10rpx}.writing-paper{background:#fffef9;border:1rpx solid #ebe9de;border-radius:24rpx;padding:26rpx}.content-input{width:100%;min-height:430rpx;font-size:30rpx;line-height:2.05;overflow-wrap:break-word}.word-count{text-align:right;font-size:21rpx;color:#abb09f;margin-top:25rpx}.tags-area{margin-top:32rpx}.tags-area input{background:#edede5;padding:20rpx 24rpx;border-radius:15rpx;height:80rpx;font-size:26rpx}.tags-area .small{margin-top:12rpx}.save-status{text-align:center;font-size:23rpx;color:#8b947f;margin:34rpx 0 22rpx}.discard{margin-top:15rpx}
