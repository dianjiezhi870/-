<view class="page"><view class="eyebrow">DAYS TO REMEMBER</view><view class="heading calendar-heading">每一天，都在这里。</view><view wx:if="error" class="error">{{error}}</view>
  <view class="card calendar-card"><view class="between month-nav"><button class="month-arrow" data-step="-1" bindtap="move" aria-label="上个月">‹</button><picker mode="date" fields="month" start="1900-01" end="{{maxMonth}}" value="{{month}}" bindchange="pickMonth"><text class="section-title">{{monthLabel}} ⌄</text></picker><button class="month-arrow" data-step="1" bindtap="move" disabled="{{nextDisabled}}" aria-label="下个月">›</button></view>
  <view class="week-row"><text wx:for="{{weekdays}}" wx:key="*this">{{item}}</text></view>
  <view class="grid"><view wx:for="{{cells}}" wx:key="date" class="cell {{!item.inMonth ? 'other' : ''}} {{item.future ? 'future' : ''}}" data-date="{{item.date}}" bindtap="select" role="button" aria-label="{{item.date + (item.hasEntry ? '，有日记' : '')}}"><view class="date-circle {{item.today ? 'is-today' : ''}} {{item.selected ? 'selected' : ''}}">{{item.day}}<view wx:if="item.hasEntry" class="dot"></view></view></view></view>
  <view class="between month-bottom"><text>{{monthCount}} 天留下了记录</text><button class="quiet" bindtap="today">回到今天</button></view></view>
  <view class="selected-date">{{selectedLabel}}</view>
  <view wx:if="entry" class="card" bindtap="open" role="button"><view class="between"><text class="pill">{{entry.moodSymbol}} {{entry.moodLabel}}</text><text class="tiny-label">{{entry.weather}}</text></view><view class="entry-title selected-title">{{entry.title}}</view><view class="entry-preview">{{entry.preview}}</view><view class="between"><text class="tag">{{entry.wordCount}} 字</text><text class="quiet">读这一天 →</text></view></view>
  <view wx:else class="empty card"><image class="empty-art" src="/assets/calendar-active.png"/><view class="empty-title">{{future ? '未来，留给慢慢发生' : '这一天，还没有写下'}}</view><view class="sub">{{future ? '等这一天到来，再记录它的故事。' : '一个瞬间，一点心情，都可以。'}}</view><button wx:if="!future" class="quiet" bindtap="open">{{selected === maxMonth + '-01' ? '记录这一天' : '为这一天写一篇'}} →</button></view>
</view>
