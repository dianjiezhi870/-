.calendar-heading{font-size:47rpx;margin:12rpx 0 36rpx}.calendar-card{padding:20rpx 22rpx}.month-nav{padding:8rpx 0 28rpx}.month-arrow{width:70rpx;height:70rpx;font-size:46rpx;background:transparent;line-height:1.2;color:#78886c}.week-row{display:flex;color:#a5a99d;font-size:23rpx;padding-bottom:16rpx}.week-row text{width:14.285%;text-align:center}.grid{display:flex;flex-wrap:wrap}.cell{width:14.285%;height:85rpx;display:flex;align-items:center;justify-content:center}.date-circle{width:65rpx;height:65rpx;border-radius:50%;position:relative;display:flex;align-items:center;justify-content:center;font-family:Georgia,serif;font-size:29rpx}.date-circle.is-today{border:1rpx solid #b1bea3}.date-circle.selected{background:#5c735e;color:#fffef7}.other{color:#c6cabd}.future{opacity:.4}.dot{position:absolute;bottom:7rpx;left:29rpx;width:7rpx;height:7rpx;border-radius:50%;background:#c49d72}.selected .dot{background:#e7d8b2}.month-bottom{margin:18rpx 12rpx 0;border-top:1rpx solid #eeede6;padding-top:10rpx;color:#a1a797;font-size:23rpx}.selected-date{color:#7f8a78;font-size:25rpx;margin:34rpx 0 23rpx}.selected-title{margin-top:23rpx}
