page{background:#f7f5ef;color:#303b34;font-family:-apple-system,BlinkMacSystemFont,"PingFang SC","Microsoft YaHei",sans-serif;font-size:28rpx;line-height:1.65}
view,text,button,input,textarea{box-sizing:border-box}button{margin:0;font-size:28rpx;border-radius:22rpx;line-height:1.5}button::after{border:0}button[disabled]{opacity:.45}input,textarea{font-family:inherit;color:#303b34}button:active{opacity:.8}
.page{padding:32rpx 36rpx 56rpx;padding-bottom:calc(56rpx + env(safe-area-inset-bottom))}.eyebrow{font-size:20rpx;letter-spacing:5rpx;color:#858a7e}.heading{font-family:"Songti SC","Noto Serif CJK SC",serif;font-size:54rpx;line-height:1.35;font-weight:600;letter-spacing:2rpx}.sub{font-size:25rpx;color:#888c80}.muted{color:#8b8f84}.row{display:flex;align-items:center}.between{display:flex;align-items:center;justify-content:space-between}.gap{gap:16rpx}.card{background:#fffefb;border:1rpx solid #ebe9df;border-radius:28rpx;padding:30rpx}.section-title{font-size:31rpx;font-weight:600;letter-spacing:1rpx}.primary{background:#586f60;color:#fffdf7;padding:25rpx 28rpx;font-weight:500}.secondary{background:#ebece4;color:#556a5c;padding:23rpx 28rpx}.quiet{background:transparent;color:#657a69;padding:12rpx 0;font-size:25rpx}.danger{color:#a56852}.danger-button{color:#a56852;background:#f5ece6;padding:23rpx 28rpx}.pill{display:inline-block;padding:5rpx 17rpx;border-radius:99rpx;background:#edf0e7;color:#66775f;font-size:22rpx}.line{height:1rpx;background:#ecebe3;margin:28rpx 0}.empty{padding:60rpx 28rpx;text-align:center}.empty-title{font-size:32rpx;margin:20rpx 0 10rpx}.empty-art{width:104rpx;height:104rpx;opacity:.55}.error{margin:24rpx 0;padding:22rpx;background:#f9eee6;color:#9b664d;border-radius:16rpx;font-size:25rpx}.tag{display:inline-block;margin-right:12rpx;margin-top:12rpx;color:#8a8e82;font-size:22rpx}.body-copy{white-space:pre-wrap;overflow-wrap:break-word;line-height:1.95}.small{font-size:23rpx}.spacer{height:32rpx}.tiny-label{font-size:23rpx;color:#7c8679}.tap{min-height:80rpx;display:flex;align-items:center}.field-label{font-size:25rpx;color:#77816f;margin-bottom:18rpx}.entry-title{font-size:32rpx;font-weight:500;line-height:1.5;word-break:break-all}.entry-preview{color:#8b8d82;font-size:25rpx;margin-top:14rpx;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;word-break:break-all}.footer-note{text-align:center;font-size:22rpx;color:#9d9f94;margin:36rpx 0 10rpx}.full{width:100%}.link-row{padding:27rpx 0;display:flex;justify-content:space-between;align-items:center;border-bottom:1rpx solid #eeede5}.arrow{font-size:35rpx;color:#b1b5a8}.notice{padding:22rpx 25rpx;border-radius:20rpx;background:#ecede4;color:#818978;font-size:23rpx;line-height:1.7}.notice button{font-size:23rpx;white-space:nowrap;padding:10rpx;background:transparent;color:#5b735f}
