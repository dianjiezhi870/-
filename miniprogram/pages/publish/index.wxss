.publish-page { padding: 36rpx 30rpx 52rpx; }
.page-intro { padding: 12rpx 4rpx 34rpx; }
.eyebrow { display: block; color: #648d8b; font-size: 18rpx; letter-spacing: 4rpx; margin-bottom: 18rpx; }
.page-title { font-size: 43rpx; font-weight: 600; color: #193c3b; letter-spacing: 1rpx; }
.intro-copy { font-size: 25rpx; color: #81918b; margin-top: 15rpx; }
.demo-note { margin-bottom: 24rpx; padding: 16rpx 22rpx; background: #eaf3ed; border-radius: 12rpx; color: #6c817b; font-size: 21rpx; }
.connection-card { padding: 26rpx; margin-bottom: 24rpx; color: #5b7671; font-size: 25rpx; }
.connection-card button { margin-top: 20rpx; }
.photo-section, .writing-card, .details-card { background: #fff; border-radius: 24rpx; margin-bottom: 24rpx; padding: 28rpx; }
.section-head { display: flex; justify-content: space-between; align-items: center; margin-bottom: 25rpx; }
.section-title { font-size: 27rpx; color: #274640; font-weight: 500; }
.image-count { color: #8a9a94; font-size: 22rpx; }
.photo-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 14rpx; }
.photo-tile { position: relative; height: 190rpx; border-radius: 14rpx; overflow: hidden; background: #edf3ee; }
.selected-photo { width: 100%; height: 100%; }
.remove-photo { position: absolute; right: 7rpx; top: 7rpx; border: 0; width: 38rpx; height: 38rpx; line-height: 34rpx; padding: 0; background: rgba(18, 39, 37, .6); color: #fff; border-radius: 50%; font-size: 30rpx; }
button::after { border: none; }
.cover-label { position: absolute; bottom: 0; left: 0; background: #257b78; padding: 6rpx 15rpx; color: #fff; font-size: 19rpx; border-radius: 0 12rpx 0 0; }
.add-photo { width: 100%; height: 190rpx; background: #f2f6f1; color: #68938b; padding: 0; border: 1rpx dashed #c5d7cb; border-radius: 14rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; line-height: 1.4; }
.add-symbol { font-size: 54rpx; font-weight: 200; line-height: 1.1; }
.add-label { font-size: 22rpx; margin-top: 12rpx; }
.field-help { color: #96a29b; font-size: 19rpx; line-height: 1.8; margin-top: 19rpx; }
.title-input { height: 64rpx; font-size: 31rpx; color: #23423d; font-weight: 500; }
.divider { height: 1rpx; background: #eef2eb; margin: 15rpx 0 24rpx; }
.story-input { width: 100%; min-height: 180rpx; font-size: 27rpx; color: #4e655d; line-height: 1.8; }
.word-count { text-align: right; font-size: 20rpx; color: #a0ada4; margin-top: 16rpx; }
.category-list { display: flex; gap: 15rpx; flex-wrap: wrap; margin: 24rpx 0 28rpx; }
.category-pill { border-radius: 40rpx; background: #f1f5ef; color: #7b9184; font-size: 24rpx; line-height: 1; padding: 18rpx 29rpx; margin: 0; }
.category-pill.selected { background: #dcefea; color: #1e8179; font-weight: 500; }
.location-row { display: flex; align-items: center; gap: 16rpx; border-top: 1rpx solid #eef2eb; padding-top: 25rpx; }
.location-mark { font-size: 34rpx; color: #6d9990; }
.location-input { flex: 1; font-size: 25rpx; color: #42685c; }
.publish-note { color: #8d9b91; font-size: 21rpx; text-align: center; line-height: 1.8; margin: 27rpx 13rpx 23rpx; }
.publish-button { background: #237f7b; color: #fff; font-size: 28rpx; border-radius: 45rpx; min-height: 90rpx; line-height: 90rpx; letter-spacing: 2rpx; }
.publish-button[disabled] { background: #9abdb2; color: #f4faf6; }
.draft-note { color: #a0aca2; text-align: center; font-size: 20rpx; margin-top: 19rpx; }
.form-error { border-radius: 12rpx; background: #fff0e8; color: #a66546; font-size: 24rpx; line-height: 1.8; padding: 18rpx 23rpx; }
