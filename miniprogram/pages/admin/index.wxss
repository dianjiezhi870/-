.admin-page { padding: 36rpx 28rpx 55rpx; }
button::after { border: none; }
.admin-intro { padding: 10rpx 5rpx 34rpx; }
.eyebrow { display: block; color: #6c938a; font-size: 18rpx; letter-spacing: 4rpx; margin-bottom: 17rpx; }
.page-title { color: #274b42; font-size: 44rpx; font-weight: 600; }
.intro-copy { color: #879b8b; margin-top: 14rpx; font-size: 24rpx; }
.demo-note { margin-bottom: 24rpx; border-radius: 12rpx; padding: 15rpx 21rpx; background: #e9f1e4; color: #79907a; font-size: 20rpx; line-height: 1.7; }
.music-card { background: #fff; border-radius: 24rpx; padding: 29rpx 27rpx; }
.section-heading { display: flex; justify-content: space-between; align-items: center; gap: 16rpx; }
.section-heading > view { flex: 1; }
.section-heading switch { transform: scale(.83); transform-origin: right center; }
.section-title { color: #2d5145; font-size: 30rpx; font-weight: 600; }
.section-subtitle { color: #94a18f; font-size: 21rpx; line-height: 1.7; margin-top: 10rpx; display: block; }
.music-field { margin-top: 27rpx; }
.field-label { color: #77927b; font-size: 21rpx; display: block; margin-bottom: 12rpx; }
.music-input { font-size: 26rpx; color: #3c6350; background: #f5f7f0; border-radius: 11rpx; padding: 19rpx 21rpx; }
.audio-picker { margin: 28rpx 0 0; padding: 23rpx 18rpx; border: 1rpx dashed #c8d9c1; border-radius: 14rpx; display: flex; align-items: center; gap: 18rpx; line-height: 1.5; text-align: left; background: #f4f7ed; }
.audio-symbol { color: #74a68b; font-size: 42rpx; padding: 0 10rpx; }
.audio-text { flex: 1; min-width: 0; }
.audio-title { color: #588269; font-size: 24rpx; display: block; word-break: break-all; }
.audio-subtitle { color: #9aaa91; font-size: 18rpx; display: block; margin-top: 9rpx; }
.picker-arrow { color: #9fb596; font-size: 33rpx; }
.music-help { color: #9fa98f; font-size: 19rpx; line-height: 1.8; margin: 18rpx 0 25rpx; }
.save-music { background: #237f77; color: #fff; border-radius: 40rpx; font-size: 25rpx; line-height: 78rpx; }
.save-music[disabled] { background: #c0d7c7; color: #f6faf3; }
.queue-heading { display: flex; align-items: center; justify-content: space-between; gap: 15rpx; margin: 43rpx 5rpx 25rpx; }
.queue-count { color: #669b7d; background: #e1eedf; font-size: 25rpx; min-width: 51rpx; text-align: center; height: 51rpx; line-height: 51rpx; border-radius: 50%; }
.state-card { background: #fff; border-radius: 22rpx; padding: 55rpx 30rpx; color: #8e9e83; text-align: center; font-size: 25rpx; line-height: 1.8; margin-bottom: 23rpx; }
.state-symbol { color: #93bda2; font-size: 67rpx; line-height: 1.2; margin-bottom: 22rpx; }
.empty-title { color: #5c7f61; font-size: 27rpx; }
.empty-copy { font-size: 22rpx; margin-top: 12rpx; }
.state-action { display: inline-block; background: #e5f0df; color: #4f8b65; border-radius: 40rpx; margin-top: 27rpx; padding: 15rpx 34rpx; line-height: 1.5; font-size: 23rpx; }
.review-card { background: #fff; border-radius: 23rpx; padding: 27rpx; margin-bottom: 24rpx; }
.review-author { display: flex; align-items: center; gap: 16rpx; }
.review-avatar, .review-avatar-placeholder { width: 65rpx; height: 65rpx; border-radius: 50%; flex-shrink: 0; }
.review-avatar-placeholder { display: flex; justify-content: center; align-items: center; background: #e1eedd; color: #81a47a; font-size: 25rpx; }
.review-author-text { flex: 1; min-width: 0; }
.author-name { color: #55734f; font-size: 23rpx; display: block; }
.submission-time { display: block; margin-top: 8rpx; font-size: 19rpx; color: #a0ac92; }
.pending-label { color: #ab9559; background: #faf3dd; padding: 8rpx 16rpx; font-size: 19rpx; border-radius: 25rpx; }
.review-title { color: #385d43; font-size: 30rpx; font-weight: 500; line-height: 1.6; margin-top: 25rpx; word-break: break-all; }
.review-content { color: #819176; font-size: 24rpx; line-height: 1.9; margin-top: 15rpx; white-space: pre-wrap; word-break: break-all; }
.review-photos { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10rpx; margin-top: 23rpx; }
.review-photos image { width: 100%; height: 197rpx; background: #edf1e4; border-radius: 10rpx; }
.review-location { color: #9bac8c; font-size: 21rpx; margin-top: 19rpx; }
.review-actions { display: flex; gap: 18rpx; border-top: 1rpx solid #eef2e5; margin-top: 25rpx; padding-top: 24rpx; }
.review-actions button { flex: 1; font-size: 24rpx; line-height: 71rpx; border-radius: 40rpx; margin: 0; }
.reject-button { color: #a18665; background: #f5f1e8; }
.approve-button { color: #fff; background: #328a72; }
.review-actions button[disabled] { opacity: .55; }
