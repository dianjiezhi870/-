.home-page { min-height: 100vh; background: #f5f7f4; padding: 30rpx 30rpx 0; color: #233a3b; box-sizing: border-box; }
.masthead { padding: 8rpx 0 25rpx; }
.brand-line { display: flex; align-items: center; }
.brand-mark { width: 43rpx; height: 36rpx; border: 3rpx solid #267d7d; border-radius: 9rpx; margin-right: 13rpx; display: flex; justify-content: center; align-items: center; position: relative; }
.brand-mark::before { content: ''; width: 16rpx; height: 6rpx; background: #267d7d; border-radius: 4rpx 4rpx 0 0; position: absolute; top: -8rpx; left: 6rpx; }
.lens { width: 17rpx; height: 17rpx; border: 3rpx solid #267d7d; border-radius: 50%; }
.brand-name { font-size: 40rpx; letter-spacing: 3rpx; font-weight: 600; }
.brand-dot { color: #a8b8b2; margin: 0 13rpx; }
.brand-caption { color: #80928d; font-size: 21rpx; letter-spacing: 1rpx; }
.eyebrow { font-size: 15rpx; letter-spacing: 4rpx; color: #83938b; margin-top: 15rpx; }
.search-box { height: 78rpx; border: 1rpx solid #e4eae3; background: #fff; display: flex; align-items: center; border-radius: 16rpx; padding: 0 21rpx; margin-bottom: 26rpx; }
.search-icon { width: 23rpx; height: 23rpx; border: 2rpx solid #9badab; border-radius: 50%; margin-right: 20rpx; position: relative; flex-shrink: 0; }
.search-icon::after { content: ''; position: absolute; height: 9rpx; width: 2rpx; background: #9badab; right: -5rpx; bottom: -6rpx; transform: rotate(-42deg); }
.search-input { flex: 1; height: 70rpx; font-size: 24rpx; min-width: 0; }
.search-placeholder { color: #a1afaa; }
.search-clear { font-size: 36rpx; color: #849c96; padding: 12rpx; }
.search-submit { font-size: 23rpx; padding: 8rpx 0 8rpx 18rpx; color: #237f7e; border-left: 1rpx solid #e2e9e4; }
.hero { height: 348rpx; border-radius: 20rpx; position: relative; overflow: hidden; background: #437e78; }
.hero-image, .hero-shade { position: absolute; height: 100%; width: 100%; }
.hero-shade { background: linear-gradient(90deg, rgba(12, 55, 54, .7), rgba(12, 55, 54, .08)); }
.hero-content { position: absolute; left: 35rpx; top: 35rpx; color: #fff; }
.hero-kicker { display: flex; align-items: center; font-size: 20rpx; letter-spacing: 4rpx; color: #d7ede0; }
.hero-line { height: 1rpx; width: 28rpx; background: #d7ede0; margin-right: 12rpx; }
.hero-title { font-size: 51rpx; font-weight: 400; letter-spacing: 9rpx; line-height: 1.4; margin-top: 22rpx; }
.hero-title-second { display: block; }
.hero-caption { margin-top: 18rpx; font-size: 21rpx; letter-spacing: 2rpx; color: #e1ede5; }
.hero-number { color: #f0f7ec; font-size: 16rpx; letter-spacing: 2rpx; position: absolute; right: 24rpx; bottom: 24rpx; }
.music-card { margin: 21rpx 0 40rpx; padding: 20rpx 23rpx; background: #ecf2eb; border-radius: 16rpx; display: flex; align-items: center; border: 1rpx solid #e0e9df; }
.record { width: 68rpx; height: 68rpx; border-radius: 50%; background: repeating-radial-gradient(circle, #2e4c48 0, #2e4c48 3rpx, #395b56 4rpx, #395b56 5rpx); display: flex; align-items: center; justify-content: center; flex-shrink: 0; margin-right: 21rpx; }
.record-center { width: 24rpx; height: 24rpx; border-radius: 50%; background: #b7d5c4; border: 5rpx solid #97b9a9; }
.record-playing { animation: record-spin 8s linear infinite; }
@keyframes record-spin { from { transform: rotate(0); } to { transform: rotate(360deg); } }
.music-info { flex: 1; min-width: 0; }
.music-label { font-size: 18rpx; color: #81948b; letter-spacing: 2rpx; display: flex; align-items: center; }
.music-admin-tag { font-size: 15rpx; color: #7e9d8b; margin-left: 12rpx; border: 1rpx solid #cbdacf; padding: 2rpx 7rpx; border-radius: 5rpx; letter-spacing: 0; }
.music-title { font-size: 24rpx; color: #3a6259; margin-top: 7rpx; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.music-artist { font-size: 19rpx; color: #83998c; margin-top: 4rpx; }
.music-control { width: 53rpx; height: 53rpx; border: 1rpx solid #aec9bb; border-radius: 50%; margin-left: 18rpx; display: flex; justify-content: center; align-items: center; }
.control-play view { width: 0; height: 0; border-top: 9rpx solid transparent; border-bottom: 9rpx solid transparent; border-left: 13rpx solid #3c8275; margin-left: 4rpx; }
.control-pause view { height: 18rpx; width: 13rpx; border-left: 4rpx solid #3c8275; border-right: 4rpx solid #3c8275; box-sizing: border-box; }
.music-warning { margin-top: -25rpx; margin-bottom: 27rpx; font-size: 20rpx; color: #8c7965; }
.discover-heading { display: flex; align-items: flex-end; justify-content: space-between; margin-bottom: 22rpx; }
.section-eyebrow { color: #8b9f94; font-size: 15rpx; letter-spacing: 3rpx; margin-bottom: 7rpx; }
.discover-title { font-size: 35rpx; font-weight: 600; letter-spacing: 2rpx; }
.discover-dot { color: #2f9c92; margin-left: 8rpx; }
.sort-control { font-size: 22rpx; color: #9aaaa3; padding-bottom: 5rpx; }
.sort-control text { padding: 10rpx 0 10rpx 12rpx; }
.sort-control .sort-active { color: #267b75; font-weight: 600; }
.sort-control .sort-separator { color: #c2cfc7; font-size: 18rpx; }
.category-scroll { white-space: nowrap; margin-bottom: 24rpx; width: 100%; }
.categories { display: flex; align-items: center; }
.category-pill { padding: 14rpx 29rpx; margin-right: 15rpx; font-size: 24rpx; color: #7b9087; border-radius: 12rpx; background: #edf0e9; flex-shrink: 0; }
.category-active { background: #237f7b; color: #fff; }
.demo-note { color: #8c9d92; font-size: 19rpx; display: flex; align-items: center; margin: -5rpx 0 20rpx; }
.demo-dot { width: 7rpx; height: 7rpx; background: #98b3a0; border-radius: 50%; margin-right: 9rpx; }
.refresh-note { text-align: center; font-size: 21rpx; color: #7d9d90; padding: 8rpx 0 19rpx; }
.waterfall { display: flex; gap: 20rpx; align-items: flex-start; }
.waterfall-column { width: calc((100% - 20rpx) / 2); min-width: 0; }
.photo-card { border-radius: 16rpx; overflow: hidden; background: white; margin-bottom: 20rpx; box-shadow: 0 4rpx 16rpx rgba(47, 73, 57, .025); }
.photo-cover { position: relative; overflow: hidden; background: #e4ebe0; }
.photo-image { width: 100%; display: block; }
.photo-category { position: absolute; left: 13rpx; top: 13rpx; background: rgba(240, 246, 237, .86); padding: 5rpx 12rpx; border-radius: 6rpx; color: #496b5a; font-size: 16rpx; letter-spacing: 1rpx; }
.photo-count { position: absolute; right: 12rpx; bottom: 12rpx; background: rgba(32, 62, 48, .4); color: #fff; padding: 4rpx 9rpx; border-radius: 5rpx; font-size: 17rpx; }
.photo-body { padding: 18rpx 16rpx 17rpx; }
.photo-title { color: #314c43; font-size: 25rpx; font-weight: 500; line-height: 1.55; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
.photo-footer { display: flex; align-items: center; justify-content: space-between; margin-top: 17rpx; }
.photo-author { display: flex; align-items: center; min-width: 0; flex: 1; margin-right: 8rpx; }
.author-avatar, .avatar-placeholder { height: 33rpx; width: 33rpx; border-radius: 50%; margin-right: 8rpx; flex-shrink: 0; }
.avatar-placeholder { background: #e5eee4; color: #84a08c; font-size: 17rpx; text-align: center; line-height: 33rpx; }
.author-name { font-size: 19rpx; color: #8a9c8f; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.like-button { display: flex; gap: 5rpx; align-items: center; color: #99a99d; font-size: 19rpx; flex-shrink: 0; padding: 8rpx 0 8rpx 7rpx; }
.like-heart { font-size: 30rpx; line-height: 1; }
.is-liked { color: #218f87; }
.feed-placeholder { display: flex; gap: 20rpx; }
.placeholder-column { width: calc((100% - 20rpx) / 2); }
.placeholder-card { height: 350rpx; border-radius: 16rpx; background: linear-gradient(120deg, #e9eee5, #f0f3ed, #e9eee5); margin-bottom: 20rpx; }
.placeholder-tall { height: 460rpx; }
.empty-state { text-align: center; padding: 75rpx 25rpx; border: 1rpx dashed #d3dfd2; border-radius: 18rpx; margin-top: 10rpx; }
.empty-aperture { font-size: 80rpx; color: #a6c5b5; line-height: 1; margin-bottom: 24rpx; }
.empty-title { font-size: 27rpx; color: #5e7b68; }
.empty-description { font-size: 22rpx; line-height: 1.7; color: #8c9f90; margin-top: 14rpx; }
.empty-publish { color: #fff; background: #277f76; display: inline-block; border-radius: 12rpx; font-size: 24rpx; line-height: 64rpx; padding: 0 32rpx; margin-top: 28rpx; }
.empty-publish::after, .retry-button::after { border: none; }
.feed-error { text-align: center; font-size: 23rpx; color: #99856e; padding: 30rpx 10rpx; }
.retry-button { background: #e5eee4; color: #4c7e65; border-radius: 10rpx; font-size: 22rpx; display: inline-block; padding: 0 30rpx; margin: 18rpx auto 0; line-height: 58rpx; }
.feed-bottom { font-size: 20rpx; text-align: center; color: #a0afa1; padding: 25rpx 0 10rpx; letter-spacing: 1rpx; }
.bottom-line { height: 1rpx; width: 35rpx; background: #cbd8c9; margin: 22rpx auto 0; }
.page-end { height: 45rpx; }
