page{--primary:#168d83;--cyan:#208eaa;--ink:#183b36;--muted:#82948d;--line:#e5eeea;--surface:#fff;background:#f6f9f7;color:#183b36;font-family:-apple-system,BlinkMacSystemFont,"PingFang SC","Microsoft YaHei",sans-serif;font-size:28rpx;line-height:1.6;box-sizing:border-box}
view,text,input,textarea,button{box-sizing:border-box}button{font-size:28rpx;line-height:1.6}button::after{border:0}button[disabled]{opacity:.5}image{display:block} .page{padding:28rpx 32rpx 56rpx}.card{background:#fff;border-radius:24rpx;overflow:hidden}.button{background:#168d83;color:white;border-radius:18rpx;padding:22rpx 32rpx;font-weight:600;font-size:28rpx}.button-secondary{background:#e8f4ef;color:#168d83;border-radius:18rpx;padding:20rpx 28rpx}.muted{color:#82948d}.empty{text-align:center;color:#82948d;padding:80rpx 32rpx}.input{width:100%;padding:22rpx 24rpx;background:#f3f7f5;border:1rpx solid #e5eeea;border-radius:14rpx;font-size:28rpx;color:#183b36}.section-title{font-size:32rpx;font-weight:600;letter-spacing:1rpx}.safe-bottom{padding-bottom:calc(36rpx + env(safe-area-inset-bottom))}
